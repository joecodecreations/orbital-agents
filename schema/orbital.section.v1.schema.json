{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbital.local/schema/orbital.section.v1.schema.json",
  "title": "Orbital section",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "icon",
    "order",
    "layout",
    "blocks",
    "tabs",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "orbital.section.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "icon": {
      "type": "string"
    },
    "icon_image": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(/v1/media/|https://)",
      "description": "App icon drawn in place of the SF Symbol in icon. A /v1/media/ path or an https URL."
    },
    "order": {
      "type": "integer"
    },
    "accent": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "layout": {
      "enum": [
        "page",
        "tabs",
        "sidebar"
      ],
      "description": "page: blocks only. tabs: blocks above tabs[]. sidebar: blocks above nodes[]."
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      },
      "description": "The section's own blocks. On page layout they are the page; on tabs and sidebar layouts the apps draw them above the tabs or the node's content, on every tab and node (a banner, today's status). Ops reach them without node_id and tab_id."
    },
    "tabs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tab"
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "space": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Groups sections into one of the app's home tiles (a project, a household, a server fleet)."
    },
    "space_title": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 40
    },
    "space_icon": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "description": "SF Symbol for the space tile."
    }
  },
  "$defs": {
    "tab": {
      "type": "object",
      "required": [
        "id",
        "title",
        "blocks"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "title",
        "order",
        "layout",
        "blocks",
        "tabs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon_image": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(/v1/media/|https://)",
          "description": "App icon drawn in place of the SF Symbol in icon. A /v1/media/ path or an https URL."
        },
        "order": {
          "type": "integer"
        },
        "layout": {
          "enum": [
            "page",
            "tabs"
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "tabs": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/tab"
          }
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "examples": [
            "heading",
            "paragraph",
            "bullets",
            "callout",
            "metrics",
            "key_value",
            "table",
            "timeline",
            "divider",
            "chart",
            "image",
            "hero",
            "buttons",
            "product",
            "ledger",
            "tasks",
            "series",
            "insight_cards",
            "videos",
            "progress",
            "status",
            "links"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Every block has type and id. product, ledger, tasks, series, insight_cards, videos, buttons, hero, progress, status and links are checked field by field.",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "product"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/product"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ledger"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/ledger"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tasks"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/tasks"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "buttons"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/buttons"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hero"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/hero"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "progress"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/progress"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "status"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/status"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "links"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/links"
          }
        }
      ]
    },
    "metric": {
      "type": "object",
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "value": {
          "type": "string",
          "maxLength": 60
        },
        "caption": {
          "type": "string"
        },
        "delta": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "up",
            "down",
            "flat"
          ]
        }
      }
    },
    "product": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "app",
            "game",
            "site",
            "service"
          ]
        },
        "company": {
          "type": "string",
          "maxLength": 80
        },
        "headline": {
          "type": "string",
          "maxLength": 200
        },
        "tone": {
          "enum": [
            "info",
            "success",
            "warning",
            "danger"
          ]
        },
        "checked_at": {
          "type": "string"
        },
        "releases": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "platform",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "live",
                  "pending",
                  "testing",
                  "draft",
                  "rejected",
                  "removed"
                ]
              },
              "store": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "build": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "since": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "ratings": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "store": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "reviews": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "at"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "store": {
                "type": "string"
              },
              "rating": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string",
                "maxLength": 4000
              },
              "author": {
                "type": "string"
              },
              "territory": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "links": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        },
        "space": {
          "type": "string",
          "maxLength": 80,
          "description": "Groups the numbers across sections (company is the older name)."
        }
      }
    },
    "ledger": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3,8}$"
        },
        "company": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "connected": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 400
        },
        "as_of": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "days": {
          "type": "array",
          "maxItems": 3000,
          "items": {
            "type": "object",
            "required": [
              "date",
              "amount"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "amount": {
                "type": "number"
              },
              "net": {
                "type": "number"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "product": {
                "type": "string",
                "maxLength": 80
              },
              "category": {
                "type": "string",
                "maxLength": 80
              },
              "source": {
                "type": "string",
                "maxLength": 80
              },
              "company": {
                "type": "string",
                "maxLength": 80
              },
              "space": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        },
        "entries": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "at",
              "amount"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "amount": {
                "type": "number"
              },
              "net": {
                "type": "number"
              },
              "label": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "product": {
                "type": "string",
                "maxLength": 80
              },
              "category": {
                "type": "string",
                "maxLength": 80
              },
              "source": {
                "type": "string",
                "maxLength": 80
              },
              "company": {
                "type": "string",
                "maxLength": 80
              },
              "space": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "space": {
          "type": "string",
          "maxLength": 80,
          "description": "Groups the numbers across sections (company is the older name)."
        }
      }
    },
    "tasks": {
      "type": "object",
      "description": "A checklist the app ticks (action task.set_done) and adds to (task.add). The owner feed writes the taps back to its source.",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "subtitle": {
          "type": "string",
          "maxLength": 200
        },
        "empty_text": {
          "type": "string",
          "maxLength": 200
        },
        "collapsed": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "add": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 40
            },
            "remind_options": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": [
                  "days",
                  "label"
                ],
                "properties": {
                  "days": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 120
                    }
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            },
            "group": {
              "type": "string",
              "maxLength": 64,
              "description": "Group new items land in."
            },
            "groups": {
              "type": "array",
              "maxItems": 60,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label"
                ]
              }
            }
          }
        },
        "items": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "done": {
                "type": "boolean"
              },
              "done_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "due": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "due_label": {
                "type": "string",
                "maxLength": 80
              },
              "status": {
                "enum": [
                  "ready",
                  "waiting",
                  "blocked",
                  "contingent",
                  "later",
                  "done"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 4000
              },
              "tags": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 24
                }
              },
              "can_toggle": {
                "type": "boolean"
              },
              "pending": {
                "type": "boolean"
              },
              "group": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        }
      }
    },
    "tap": {
      "type": "object",
      "required": [
        "type"
      ],
      "description": "Where a tap goes. agent prefills the Desk with prompt; open goes to a page; url opens a link; post sends an orbital.action.v1 back to the section's owner feed (item_id = the button id) and the button shows pending until it answers; run_agent opens Run agent in the app filled in with machine, agent, prompt, cwd and title.",
      "properties": {
        "type": {
          "enum": [
            "agent",
            "open",
            "url",
            "post",
            "run_agent"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 100000,
          "description": "agent: prefills the Desk. run_agent: the job's prompt."
        },
        "section_id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "tab_id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
          "description": "post: the action type, e.g. server.restart."
        },
        "value": {
          "type": "object"
        },
        "confirm": {
          "type": "string",
          "maxLength": 200,
          "description": "post: ask before sending."
        },
        "machine": {
          "type": "string",
          "maxLength": 64,
          "description": "run_agent: satellite id or machine name."
        },
        "agent": {
          "type": "string",
          "maxLength": 40,
          "description": "run_agent: agent name (claude, codex, ...)."
        },
        "cwd": {
          "type": "string",
          "maxLength": 1000,
          "description": "run_agent: folder on that machine (inside its satellite.workdirs)."
        },
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "run_agent: tracker title."
        }
      }
    },
    "button": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "style": {
          "enum": [
            "primary",
            "secondary",
            "link",
            "destructive"
          ]
        },
        "url": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/tap"
        },
        "pending": {
          "type": "boolean"
        }
      }
    },
    "buttons": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/button"
          }
        }
      }
    },
    "hero": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "image": {
          "type": "object",
          "required": [
            "src",
            "alt"
          ],
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/button"
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "description": "Labelled bars: disk use, a goal, a backup. value out of max (default 100); display replaces the shown number.",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "items": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "value": {
                "type": "number"
              },
              "max": {
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 100
              },
              "display": {
                "type": "string",
                "maxLength": 40
              },
              "caption": {
                "type": "string",
                "maxLength": 120
              },
              "tone": {
                "enum": [
                  "info",
                  "success",
                  "warning",
                  "danger"
                ]
              }
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "description": "Up / down rows: services, sites, devices. Home lists every status block with a row down or degraded.",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "status": {
                "type": "string",
                "description": "up, ok, online, healthy, running, pass (up); down, error, offline, failed, critical (down); degraded, warn, warning, slow, partial (degraded); unknown. Missing means unknown.",
                "enum": [
                  "critical",
                  "degraded",
                  "down",
                  "error",
                  "fail",
                  "failed",
                  "failing",
                  "green",
                  "healthy",
                  "offline",
                  "ok",
