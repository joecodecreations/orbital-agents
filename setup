#!/usr/bin/env bash
# Orbital Agents setup. Run from the repo:  ./setup  [--role hub|satellite] [--answers FILE] [--yes] [--dry-run] [--reconfigure]
#
# 1. finds Python 3.11+ (Homebrew, python.org, pyenv, system; offers `brew install python@3.13` on macOS)
# 2. creates or updates .venv and installs this package (pip install -e ".[dev]")
# 3. links the `orbital` command into ~/.local/bin
# 4. runs the setup wizard: `orbital setup "$@"`
#
# Safe to run again: it keeps .venv (reinstalling only when pyproject.toml changed) and your settings.
# AI agents: ./setup --answers answers.toml --yes   (see config/answers.example.toml)
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$REPO/.venv"
BIN_DIR="${ORBITAL_BIN_DIR:-$HOME/.local/bin}"
MIN_MINOR=11

DRY_RUN=0
YES=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --yes|-y) YES=1 ;;
    -h|--help)
      sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
      echo
      if [ -x "$VENV/bin/orbital" ]; then "$VENV/bin/orbital" setup --help; fi
      exit 0 ;;
  esac
done
[ -t 0 ] || YES=1   # no terminal to answer questions: behave like --yes

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; RESET=$'\033[0m'
else
  BOLD=""; DIM=""; GREEN=""; YELLOW=""; RED=""; RESET=""
fi
say()  { printf '%s\n' "  $*"; }
ok()   { printf '%s\n' "  ${GREEN}✓${RESET} $*"; }
warn() { printf '%s\n' "  ${YELLOW}!${RESET} $*"; }
die()  { printf '%s\n' "  ${RED}✗${RESET} $*" >&2; exit 1; }
act()  {  # run a command, or print it in dry-run mode
  if [ "$DRY_RUN" = 1 ]; then printf '%s\n' "  ${DIM}[dry-run] run: $*${RESET}"; else "$@"; fi
}

printf '%s\n' "${BOLD}Orbital Agents: preparing Python${RESET}"

# ---------------------------------------------------------------- 1. Python 3.11+
py_ok() {  # $1 = interpreter; true when it runs and is >= 3.11
  [ -n "$1" ] && [ -x "$1" ] || command -v "$1" >/dev/null 2>&1 || return 1
  "$1" -c "import sys; sys.exit(0 if sys.version_info >= (3, $MIN_MINOR) else 1)" >/dev/null 2>&1
}

find_python() {
  local c
  local candidates=()
  [ -n "${ORBITAL_PYTHON:-}" ] && candidates+=("$ORBITAL_PYTHON")
  for v in 3.14 3.13 3.12 3.11; do
    candidates+=("/opt/homebrew/bin/python$v" "/usr/local/bin/python$v"
                 "/Library/Frameworks/Python.framework/Versions/$v/bin/python3" "python$v")
  done
  if command -v pyenv >/dev/null 2>&1; then
    local root; root="$(pyenv root 2>/dev/null || true)"
    if [ -n "$root" ] && [ -d "$root/versions" ]; then
      for c in $(ls -1 "$root/versions" 2>/dev/null | sort -rV); do candidates+=("$root/versions/$c/bin/python3"); done
    fi
  fi
  candidates+=("python3" "/usr/bin/python3" "python")
  for c in "${candidates[@]}"; do
    if py_ok "$c"; then
      command -v "$c" 2>/dev/null || echo "$c"
      return 0
    fi
  done
  return 1
}

PY=""
# An existing, healthy venv is reused as it is.
if py_ok "$VENV/bin/python"; then
  PY="$VENV/bin/python"
else
  PY="$(find_python || true)"
fi

if [ -z "$PY" ]; then
  warn "Python 3.$MIN_MINOR or newer is needed and wasn't found."
  if [ "$(uname -s)" = "Darwin" ]; then
    if command -v brew >/dev/null 2>&1; then
      answer="n"
      if [ "$YES" = 1 ]; then answer="y"; else read -r -p "  Install it now with Homebrew (brew install python@3.13)? [Y/n] " answer || true; answer="${answer:-y}"; fi
      case "$answer" in
        y|Y|yes) act brew install python@3.13; PY="$(find_python || true)" ;;
      esac
    else
      say "Install it from https://www.python.org/downloads/macos/ (or install Homebrew from https://brew.sh,"
      say "then: brew install python@3.13), and run ./setup again."
    fi
  else
    say "Install it with your package manager, for example:"
    say "  Debian/Ubuntu: sudo apt install python3 python3-venv python3-pip"
    say "  Fedora:        sudo dnf install python3"
    say "then run ./setup again (or point ORBITAL_PYTHON at a python3.11+)."
  fi
  if [ -z "$PY" ] && [ "$DRY_RUN" = 1 ]; then
    say "${DIM}[dry-run] would continue with the Python installed above${RESET}"
    exit 0
  fi
  [ -n "$PY" ] || die "no Python 3.$MIN_MINOR+; nothing was changed."
fi
ok "Python: $PY ($("$PY" -c 'import platform; print(platform.python_version())'))"

# ---------------------------------------------------------------- 2. .venv + package
STAMP="$VENV/.orbital-installed"
sha() { if command -v shasum >/dev/null 2>&1; then shasum -a 256; else sha256sum; fi; }
want_stamp="$( (cat "$REPO/pyproject.toml"; "$PY" -c 'import sys; print(sys.version)') | sha | cut -d' ' -f1)"

if [ "$PY" != "$VENV/bin/python" ]; then
  if [ -d "$VENV" ]; then
    warn ".venv exists but its Python is missing or too old; recreating it"
    act rm -rf "$VENV"
  fi
  act "$PY" -m venv "$VENV"
  ok "created .venv"
fi

if [ "$DRY_RUN" = 1 ]; then
  if [ ! -f "$STAMP" ] || [ "$(cat "$STAMP" 2>/dev/null)" != "$want_stamp" ]; then
    act "$VENV/bin/python" -m pip install --upgrade pip
    act "$VENV/bin/python" -m pip install -e "$REPO[dev]"
  else
    ok "packages up to date"
  fi
elif [ ! -f "$STAMP" ] || [ "$(cat "$STAMP" 2>/dev/null)" != "$want_stamp" ] || [ ! -x "$VENV/bin/orbital" ]; then
  say "installing packages into .venv (a minute the first time)…"
  "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check --upgrade pip
  "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check -e "$REPO[dev]"
  echo "$want_stamp" > "$STAMP"
  ok "packages installed"
else
  ok "packages up to date"
fi

# ---------------------------------------------------------------- 3. orbital on PATH
TARGET="$BIN_DIR/orbital"
if [ -e "$TARGET" ] && [ ! -L "$TARGET" ]; then
  warn "$TARGET exists and isn't a link made by setup; left alone (the command is $VENV/bin/orbital)"
elif [ "$(readlink "$TARGET" 2>/dev/null || true)" != "$VENV/bin/orbital" ]; then
  act mkdir -p "$BIN_DIR"
  act ln -sfn "$VENV/bin/orbital" "$TARGET"
  ok "linked $TARGET → $VENV/bin/orbital"
else
  ok "orbital is linked in $BIN_DIR"
fi
case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *)
    shell_rc="~/.profile"
    case "${SHELL:-}" in *zsh) shell_rc="~/.zshrc" ;; *bash) shell_rc="~/.bashrc" ;; esac
    warn "$BIN_DIR isn't on your PATH. Add it (then open a new terminal):"
    say "  echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> $shell_rc"
    ;;
esac

# ---------------------------------------------------------------- 4. the wizard
echo
if [ -x "$VENV/bin/orbital" ]; then
  exec "$VENV/bin/orbital" setup "$@"
fi
# Dry run before .venv exists: the wizard itself only needs the standard library.
if [ "$DRY_RUN" = 1 ]; then
  exec env PYTHONPATH="$REPO${PYTHONPATH:+:$PYTHONPATH}" "$PY" -c '
import argparse, sys
from orbital.cli.commands import setup as s
p = argparse.ArgumentParser(prog="orbital setup")
s.register(p)
sys.exit(s.run(p.parse_args(sys.argv[1:])))' "$@"
fi
die "$VENV/bin/orbital is missing after the install; see the pip output above"
