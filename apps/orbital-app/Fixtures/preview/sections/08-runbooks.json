        {
          "type": "paragraph",
          "id": "p",
          "text": "The NAS backs up every night at **2:00 AM** to the backup drive, then copies the newest snapshot offsite."
        },
        {
          "type": "image",
          "id": "diagram",
          "src": "/v1/media/backup-diagram.png",
