          "caption": "Where every copy lives.",
          "aspect": "16:9"
        },
        {
          "type": "bullets",
          "id": "steps",
          "title": "Swap the offsite drive",
          "ordered": true,
          "items": [
            "Wait for the nightly backup to finish.",
            "Unmount the backup drive from the dashboard.",
            "Swap it for the offsite drive.",
            "Run a test restore of one folder."
          ]
        },
        {
          "type": "callout",
          "id": "warn",
          "tone": "danger",
          "title": "Never unplug during a backup",
          "text": "The status light blinks blue while a backup runs."
        }
      ]
    },
